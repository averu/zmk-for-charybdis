#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        L_CLICK {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        R_CLICK {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E               &kp R        &kp T                      &kp Y          &kp U        &kp I      &kp O       &kp P       &kp MINUS
&kp LCTRL       &kp A  &kp S  &kp D               &kp F        &kp G                      &kp H          &kp J        &kp K      &lt 4 L     &lt 3 SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C               &kp V        &kp B                      &kp N          &kp M        &kp COMMA  &kp PERIOD  &kp SLASH   &mt LSHIFT EQUAL
                              &mt LEFT_WIN LANG2  &lt 2 SPACE  &mt LEFT_ALT LANGUAGE_1    &kp BACKSPACE  &lt 1 ENTER
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sign {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3    &kp N4     &kp N5         &kp N6     &kp N7    &kp N8     &kp N9     &kp N0         &kp TILDE
&trans  &kp LT    &kp LBRC  &kp LBKT  &kp LPAR   &kp PIPE       &kp AMPS   &kp RPAR  &kp RBKT   &kp RBRC   &kp GT         &kp GRAVE
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PERCENT    &kp CARET  &kp PLUS  &kp ASTRK  &kp UNDER  &kp BACKSLASH  &trans
                            &trans    &kp LANG2  &kp LS(TAB)    &trans     &trans
            >;
        };

        arrow {
            bindings = <
&trans  &trans      &trans     &trans        &trans        &trans    &trans         &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LG(LC(RIGHT_ARROW))  &trans  &trans
&trans  &kp LSHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans    &kp F2         &kp LEFT_ARROW          &kp UP_ARROW  &kp RIGHT_ARROW          &trans  &trans
&trans  &trans      &trans     &trans        &trans        &trans    &kp PAGE_DOWN  &kp END                 &kp HOME      &kp PAGE_UP              &trans  &trans
                               &trans        &trans        &trans    &kp DEL        &kp LANG1
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MB3  &mkp MB1  &mkp MB2  &to 4   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp MB4  &mkp MB5  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans    &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
